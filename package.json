{
  "name": "mandate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "setup:testnet": "node scripts/setup-testnet.ts",
    "setup:demo": "node --env-file=.env scripts/setup.ts",
    "dev:merchant": "pnpm --filter @mandate/merchant dev",
    "dev:facilitator": "pnpm --filter @mandate/facilitator dev",
    "dev:receipts": "pnpm --filter @mandate/receipts dev",
    "dev:web": "pnpm --filter @mandate/web dev",
    "agent": "pnpm --filter @mandate/agent start",
    "agent:mcp": "pnpm --filter @mandate/agent mcp"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
