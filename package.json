{
  "name": "mandate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @mandate/web --filter @mandate/receipts --filter @mandate/merchant --filter @mandate/facilitator dev",
    "dev:web": "pnpm --filter @mandate/web dev",
    "dev:receipts": "pnpm --filter @mandate/receipts dev",
    "dev:merchant": "pnpm --filter @mandate/merchant dev",
    "dev:facilitator": "pnpm --filter @mandate/facilitator dev",
    "setup:payments": "node scripts/setup-payments.ts",
    "setup:contracts": "node scripts/deploy-contracts.ts",
    "setup:stores": "node scripts/setup-stores.ts",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "test": "pnpm --filter @mandate/receipts test && pnpm --filter @mandate/langchain test && pnpm --filter @mandate/agent test",
    "pay:langchain": "pnpm --filter @mandate/langchain pay",
    "agent:langchain": "pnpm --filter @mandate/langchain agent",
    "agent": "pnpm --filter @mandate/agent start",
    "agent:mcp": "pnpm --filter @mandate/agent mcp",
    "test:chain": "node --env-file=.env scripts/test-live-payments.ts",
    "test:agents": "node --env-file=.env scripts/test-live-agents.ts",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml --workspace",
    "build": "pnpm --filter @mandate/web build",
    "test:ui": "pnpm --filter @mandate/web test:ui"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
