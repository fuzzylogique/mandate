{
  "name": "mandate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @mandate/web --filter @mandate/receipts dev",
    "dev:web": "pnpm --filter @mandate/web dev",
    "dev:receipts": "pnpm --filter @mandate/receipts dev",
    "setup:payments": "node scripts/setup-payments.ts",
    "setup:contracts": "node scripts/deploy-contracts.ts",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "test": "pnpm --filter @mandate/receipts test",
    "test:chain": "node --env-file=.env scripts/test-live-payments.ts",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml --workspace",
    "build": "pnpm --filter @mandate/web build",
    "test:ui": "pnpm --filter @mandate/web test:ui"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
