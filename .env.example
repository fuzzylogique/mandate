# Copy to .env. `pnpm setup:testnet` generates the three test accounts for you.
# Testnet only. Never put a mainnet secret in this file.

# Not named STELLAR_RPC_URL on purpose: the Stellar CLI reads .env files and would pick it up.
RPC_URL=https://soroban-testnet.stellar.org
# Hosted (https://x402.org/facilitator) works for classic payers only; smart-account
# payments need our own facilitator (pnpm dev:facilitator). See apps/facilitator.
FACILITATOR_URL=http://localhost:4023

# --- test accounts (written by `pnpm setup:testnet`) ---
MERCHANT_ADDRESS=
MERCHANT_SECRET=
AGENT_ADDRESS=
AGENT_SECRET=
FACILITATOR_ADDRESS=
FACILITATOR_SECRET=
# Look-alike seller that is NOT registered, to demo a refused payment.
IMPOSTOR_ADDRESS=
IMPOSTOR_SECRET=
OWNER_ADDRESS=
OWNER_SECRET=

# --- deployed contract ids (fill in after scripts/deploy-contracts.sh) ---
ED25519_VERIFIER_ID=
SPENDING_LIMIT_POLICY_ID=
SELLER_REGISTRY_ID=
VERIFIED_SELLER_POLICY_ID=
SMART_ACCOUNT_ID=
AGENT_CONTEXT_RULE_ID=

# --- agent ---
# classic = pay from AGENT_SECRET's own account; smart-account = pay from the mandate account
PAYER_MODE=classic
AGENT_NAME=demo-agent
# Optional: one extra token (C-address) the agent may pay in besides USDC.
AGENT_EXTRA_ASSET=
# Optional: make the demo seller charge in this token (C-address) instead of USDC.
MERCHANT_ASSET=

# --- dashboard ---
# Name shown as the account owner.
OWNER_NAME=Maple Analytics
MERCHANT_URL=http://localhost:4021

# --- services ---
MERCHANT_PORT=4021
FACILITATOR_PORT=4023
RECEIPTS_PORT=4022
RECEIPTS_URL=http://localhost:4022
RECEIPTS_DB=receipts.sqlite
