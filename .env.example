# Local storage. Relative paths are resolved from apps/receipts when using pnpm dev.
PAYMENTS_CHAIN_DB=workspace.sqlite
# Generated by pnpm setup:payments. Keep this key with the database.
PAYMENTS_ENCRYPTION_KEY=

# Stellar testnet services. Add funds issues demo USD directly; XLM covers network fees.
PAYMENTS_RPC_URL=https://soroban-testnet.stellar.org
PAYMENTS_HORIZON_URL=https://horizon-testnet.stellar.org
PAYMENTS_FRIENDBOT_URL=https://friendbot.stellar.org
PAYMENTS_EXPLORER_URL=https://stellar.expert/explorer/testnet

# FIAT funding uses Stripe hosted Checkout in sandbox/test mode only.
# Get a sk_test_ key from your Stripe sandbox. Live keys are rejected.
STRIPE_SECRET_KEY=
# Run: stripe listen --forward-to http://localhost:4022/api/stripe/webhook
# Copy the listener's whsec_ signing secret here, then restart the API.
STRIPE_WEBHOOK_SECRET=

# Shared contracts and registry administrator, written by pnpm setup:contracts.
SMART_ACCOUNT_WASM_HASH=
ED25519_VERIFIER_ID=
SPENDING_LIMIT_POLICY_ID=
AGENT_REGISTRY_ID=
AGENT_VERIFIER_ID=
SELLER_REGISTRY_ID=
PAYMENTS_VERIFIED_SMART_POLICY_ID=
PAYMENTS_REGISTRY_ADMIN_SECRET=
# Local Stellar CLI identity used for contract deployment.
STELLAR_SOURCE=mandate-deployer

# Browser and API. NODE_ENV=production enables Secure cookies and requires HTTPS.
NODE_ENV=development
WEB_ORIGIN=http://localhost:4020
RECEIPTS_PORT=4022
# Set to 0.0.0.0 so the iPhone app can reach the API over Wi-Fi (or use pnpm tunnel instead).
RECEIPTS_HOST=

# x402 demo stores and facilitator, written by pnpm setup:stores (run it with pnpm dev up).
# Agents with their own key can buy from these stores; their mandates still apply on chain.
STORES_URL=http://localhost:4021
MERCHANT_PORT=4021
MERCHANT_ASSET=
STORE_ATLAS_ADDRESS=
STORE_FORGE_ADDRESS=
STORE_LOOKALIKE_ADDRESS=
STORE_ATLAS_DATA_PASSWORD=
STORE_FORGE_COMPUTE_PASSWORD=
DEMO_OWNER_PASSWORD=
FACILITATOR_URL=http://localhost:4023
FACILITATOR_PORT=4023
FACILITATOR_SECRET=

# LangChain payment agent. The direct pay:langchain command does not need a model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PAYMENTS_API_URL=http://localhost:4022
