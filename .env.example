# Copy to .env, or let `pnpm setup:testnet` create it. Testnet only: never put a
# mainnet secret in this file. Setup is three steps (see the README):
#   pnpm setup:testnet          test accounts for the stores and the facilitator
#   scripts/deploy-contracts.sh contract ids below
#   pnpm setup:demo             vault key, demo dollars, trusted stores

# Not named STELLAR_RPC_URL on purpose: the Stellar CLI reads .env files and would pick it up.
RPC_URL=https://soroban-testnet.stellar.org
# Smart-account payments need our own facilitator (pnpm dev:facilitator). See apps/facilitator.
FACILITATOR_URL=http://localhost:4023

# --- test accounts (written by `pnpm setup:testnet`) ---
# FreshMart, a trusted store.
MERCHANT_ADDRESS=
MERCHANT_SECRET=
# FreshMarrt, a look-alike store that is NOT registered, so payments to it are blocked.
IMPOSTOR_ADDRESS=
IMPOSTOR_SECRET=
FACILITATOR_ADDRESS=
FACILITATOR_SECRET=
# Not used by the apps any more; setup:testnet still creates them.
AGENT_ADDRESS=
AGENT_SECRET=
OWNER_ADDRESS=
OWNER_SECRET=

# --- deployed contract ids (from scripts/deploy-contracts.sh) ---
ED25519_VERIFIER_ID=
SPENDING_LIMIT_POLICY_ID=
SELLER_REGISTRY_ID=
VERIFIED_SELLER_POLICY_ID=

# --- written by `pnpm setup:demo` ---
# Encrypts the keys the service keeps (customer accounts, hosted shoppers). Keep it secret.
PAYMENTS_ENCRYPTION_KEY=
# Contract code each customer's smart account is deployed from.
SMART_ACCOUNT_WASM_HASH=
# The seller registry admin (the mandate-deployer CLI identity), used to register stores.
PAYMENTS_REGISTRY_ADMIN_SECRET=
# GreenLeaf Market, the second trusted store.
GREENLEAF_ADDRESS=
GREENLEAF_SECRET=
# The demo-dollar token contract. Stores charge in it and shoppers pay in it.
MERCHANT_ASSET=
AGENT_EXTRA_ASSET=

# --- services ---
MERCHANT_URL=http://localhost:4021
MERCHANT_PORT=4021
FACILITATOR_PORT=4023
RECEIPTS_PORT=4022
RECEIPTS_DB=receipts.sqlite
# Where the service keeps customers, shoppers and its encrypted keys.
PAYMENTS_CHAIN_DB=
# Browser origins allowed to call the API with a session cookie.
WEB_ORIGIN=http://localhost:4020,http://127.0.0.1:4020
WEB_PORT=4020

# --- AI assistant (apps/agent) ---
# Where the assistant's connector reaches Mandate, and where it keeps its own key.
MANDATE_API_URL=http://127.0.0.1:4022
MANDATE_AGENT_FILE=
