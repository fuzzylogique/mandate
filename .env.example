# Local storage. Relative paths are resolved from apps/receipts when using pnpm dev.
PAYMENTS_CHAIN_DB=workspace.sqlite
# Generated by pnpm setup:payments. Keep this key with the database.
PAYMENTS_ENCRYPTION_KEY=

# Stellar testnet services. The current payment asset is native XLM.
PAYMENTS_RPC_URL=https://soroban-testnet.stellar.org
PAYMENTS_HORIZON_URL=https://horizon-testnet.stellar.org
PAYMENTS_FRIENDBOT_URL=https://friendbot.stellar.org
PAYMENTS_EXPLORER_URL=https://stellar.expert/explorer/testnet

# Shared contracts and registry administrator, written by pnpm setup:contracts.
SMART_ACCOUNT_WASM_HASH=
ED25519_VERIFIER_ID=
SPENDING_LIMIT_POLICY_ID=
SELLER_REGISTRY_ID=
PAYMENTS_VERIFIED_SMART_POLICY_ID=
PAYMENTS_REGISTRY_ADMIN_SECRET=
# Local Stellar CLI identity used for contract deployment.
STELLAR_SOURCE=mandate-deployer

# Browser and API. NODE_ENV=production enables Secure cookies and requires HTTPS.
NODE_ENV=development
WEB_ORIGIN=http://localhost:4020
RECEIPTS_PORT=4022
